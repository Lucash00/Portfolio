{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 5242880
  },
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": false,
    "headerText": "Portfolio personal de Lucas Moreno Corral (www.lucas-moreno-dev.com). Astro 5 + React 18 + Tailwind 3, desplegado en Cloudflare Pages. Contenido bilingue (es/en) en src/data/{projects,experiences,certificates}/{es,en}.ts. Los logos de tarjetas pasan por scripts/generate-card-logos.mjs y src/data/cardLogoPaths.ts.",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "compress": false,
    "topFilesLength": 10,
    "showLineNumbers": false,
    "truncateBase64": true,
    "copyToClipboard": false,
    "includeEmptyDirectories": false,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100,
      "includeDiffs": false,
      "includeLogs": true,
      "includeLogsCount": 20
    }
  },
  "include": [],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "package-lock.json",
      "README.md",
      ".vscode/**",
      "public/**/*.svg",
      "src/data/cardLogoUrlMap.json"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
