---
import CardLink from "../Utils/Card/CardLink.astro";
import OptimizedImage from "../Utils/OptimizedImage.astro";
import { cardEntryTitleClass } from "../Utils/Card/cardEntryTitle";
import TextContent from "../Utils/Font/TextContent";
export interface Props {
    title: string;
    provider: string;
    description: string;
    tags: string[];
    date: string;
    logo: string;
}

const { title, provider, description, tags, date, logo } = Astro.props;
---

<astro>
    <CardLink
        link={`/certificado/${encodeURIComponent(title.replace(/\s+/g, "-"))}`}
    >
        <div
        class="sm:col-span-10 sm:mt-10 sm:mb-5 md:col-span-3 lg:col-span-2 xl:col-span-2 2xl:col-span-2 flex items-center justify-center"
        >
            <div class="card-logo-wrap">
                <OptimizedImage
                    src={logo}
                    alt={title}
                    class="card-logo card-logo-img md:group-hover:animate-logoWobble"
                    width={224}
                    height={96}
                />
            </div>
        </div>
        <div
        class="min-w-0 sm:px-3 sm:py-2 md:py-4 sm:border-t-2 md:border-l-2 sm:pt-4 sm:border-slate-200 md:px-6 sm:col-span-10 md:col-span-7 lg:col-span-8 xl:col-span-8 2xl:col-span-8"
        >
            <h3 class={cardEntryTitleClass}>{title}</h3>
            <p class="text-gray-400 sm:text-sm md:text-base mb-2">
                {provider} / {date}
            </p>
            <TextContent content={description} variant="compact" />

            {
                tags.map((tag) => (
                <span class="inline-block bg-gray-300 rounded-full sm:px-2 sm:py-1 md:px-3 md:py-1 sm:mr-1 sm:my-1 md:mr-2 md:my-2 sm:text-xs md:text-sm font-semibold text-gray-700 ">
                        {tag}
                    </span>
                ))
            }
        </div>
    </CardLink>
</astro>
