---
import IconCarousel from "./IconCarousel.astro";
import { techCarouselIcons } from "../../../data/techCarouselIcons";
---

<astro>
  <div class="my-10 z-0 carousel-section ladosTransparentes">
    <div
      class="carousel-container grid grid-flow-col grid-rows-6 sm:grid-rows-3 md:grid-rows-2 lg:grid-rows-1"
      ref:"sliderRef"
    >
    <div class="carousel-track" ref:"trackRef">
      {
        techCarouselIcons.map((icon) => (
          <IconCarousel alt={icon.alt} src={`/assets/${icon.file}`} />
        ))
      }
    </div>
    </div>
  </div>
  <div
    id="tooltip"
    class="carousel-tooltip tooltip-hidden fixed z-[9999] pointer-events-none"
    role="tooltip"
    aria-hidden="true"
  >
    <span
      id="tooltip-label"
      class="carousel-tooltip-label inline-block whitespace-nowrap rounded-full border border-slate-400/55 px-3 py-1.5 text-xs font-medium tracking-wide text-white sm:text-sm md:px-3.5 md:py-2 md:text-base"
    ></span>
  </div>

  <style>
    .ladosTransparentes {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        white 40%,
        white 60%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        white 40%,
        white 60%,
        transparent 100%
      );
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
    }

    .carousel-section {
      overflow: visible;
      padding: 0.75rem 0 1rem;
    }

    .carousel-container {
      overflow-x: hidden;
      overflow-y: visible;
      width: 100%;
    }

    .carousel-track {
      display: flex;
      align-items: center;
      cursor: grab;
      user-select: none;
    }

    .active {
      cursor: grabbing;
    }

    .carousel-tooltip {
      display: block;
      visibility: visible;
      transition: none;
    }

    .carousel-tooltip-label {
      background: transparent;
      box-shadow: none;
      filter: none;
    }

    .carousel-tooltip.tooltip-hidden {
      opacity: 0;
      visibility: hidden;
      transition: none;
    }

    /* Misma máscara lateral que .ladosTransparentes, alineada al carrusel vía JS */
    .carousel-tooltip:not(.tooltip-hidden) {
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        white 40%,
        white 60%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        white 40%,
        white 60%,
        transparent 100%
      );
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
    }
  </style>

  <script>
    let intervalId: ReturnType<typeof setInterval> | null = null;
    let slider: HTMLElement | null;
    let track: HTMLElement | null;
    let tooltip: HTMLElement | null;
    let tooltipLabel: HTMLElement | null;
    let activeTooltipImg: HTMLImageElement | null = null;
    let showTooltipFrame = 0;
    let scrollAmount = 1;
    let startX = 0;
    let scrollLeft = 0;
    let isMouseDown = false;
    let isMouseOverSlider = false;
    let isUserInteracting = false;
    let interactionTimeout: ReturnType<typeof setTimeout> | null = null;

    window.addEventListener("DOMContentLoaded", () => {
      slider = document.querySelector(".carousel-container");
      track = document.querySelector(".carousel-track");
      tooltip = document.getElementById("tooltip");
      tooltipLabel = document.getElementById("tooltip-label");
      if (slider && track && tooltip && tooltipLabel) {
        document.body.appendChild(tooltip);
        cloneElements();
        intervalId = setInterval(moveCarousel, 13);
        slider.addEventListener("mousedown", handleMouseDown);
        slider.addEventListener("mouseup", handleMouseUp);
        slider.addEventListener("mousemove", handleMouseMove);
        slider.addEventListener("touchstart", handleTouchStart);
        slider.addEventListener("touchend", handleTouchEnd);
        slider.addEventListener("touchmove", handleTouchMove);
        slider.addEventListener("mouseenter", handleMouseEnter);
        slider.addEventListener("mouseleave", handleMouseLeave);
        track.addEventListener("mouseleave", handleTrackMouseLeave);
        track.addEventListener("mouseover", handleMouseOver);
        slider.addEventListener("scroll", refreshTooltip, { passive: true });
        window.addEventListener("resize", refreshTooltip, { passive: true });
      }
    });

    // Función para ajustar la velocidad de desplazamiento
    function adjustScrollSpeed() {
      const width = window.innerWidth;

      // Ajustar scrollAmount según el tamaño de la pantalla
      if (width <= 768) {
        // Dispositivos móviles (tamaño de pantalla pequeña)
        scrollAmount = 1; // Movimiento más lento
      } else if (width <= 1024) {
        // Tablets
        scrollAmount = 1; // Velocidad estándar
      } else {
        // Desktop
        scrollAmount = 2; // Movimiento más rápido
      }
    }

    // Llamar a la función cada vez que se redimensione la ventana
    window.addEventListener("resize", adjustScrollSpeed);

    // Llamar a la función al cargar la página para establecer la velocidad inicial
    adjustScrollSpeed();

    function moveCarousel() {
      if (!isMouseDown && !isMouseOverSlider && slider && track) {
        slider.scrollLeft += scrollAmount;
        const halfScrollWidth = track.scrollWidth / 2;
        if (slider.scrollLeft >= halfScrollWidth) {
          slider.scrollLeft = slider.scrollLeft % halfScrollWidth;
        }
        refreshTooltip();
      }
    }

    function cloneElements() {
      const items = Array.from(track!.children) as HTMLElement[];
      for (let i = 0; i < items.length; i++) {
        const clone = items[i].cloneNode(true) as HTMLElement;
        track!.appendChild(clone);
      }
      // Forzar scroll al inicio exacto
      slider!.scrollLeft = 0;
    }

    function handleMouseDown(e: MouseEvent) {
      isMouseDown = true;
      slider!.classList.add("active");
      startX = e.pageX - slider!.offsetLeft;
      scrollLeft = slider!.scrollLeft;
    }

    function handleMouseUp() {
      if (isMouseDown) {
        isMouseDown = false;
        slider!.classList.remove("active");
        // Ajustar scroll para evitar salto
        const halfScrollWidth = track!.scrollWidth / 2;
        slider!.scrollLeft = slider!.scrollLeft % halfScrollWidth;
      }
    }

    function handleMouseMove(e: MouseEvent) {
      if (isMouseDown) {
        e.preventDefault();
        const x = e.pageX - slider!.offsetLeft;
        const walk = (x - startX) * 1.2;
        slider!.scrollLeft = scrollLeft - walk;
        hideTooltip();

        markUserInteracting();
      }
    }

    function handleTouchStart(e: TouchEvent) {
      isMouseDown = true;
      slider!.classList.add("active");
      startX = e.touches[0].pageX - slider!.offsetLeft;
      scrollLeft = slider!.scrollLeft;
      hideTooltip();
    }

    function handleTouchEnd() {
      if (isMouseDown) {
        isMouseDown = false;
        slider!.classList.remove("active");
        // Ajustar scroll para evitar salto
        const halfScrollWidth = track!.scrollWidth / 2;
        slider!.scrollLeft = slider!.scrollLeft % halfScrollWidth;

        // Reanudar desplazamiento automático
        markUserInteracting();
      }
    }

    function handleTouchMove(e: TouchEvent) {
      if (isMouseDown) {
        e.preventDefault();
        const x = e.touches[0].pageX - slider!.offsetLeft;
        const screenWidth = window.innerWidth;
        const multiplier = screenWidth <= 768 ? 1.0 : 3;
        const walk = (x - startX) * multiplier;
        slider!.scrollLeft = scrollLeft - walk;

        markUserInteracting();
      }
    }

    function markUserInteracting() {
      isUserInteracting = true;
      if (interactionTimeout) clearTimeout(interactionTimeout);
      if (intervalId) {
        clearInterval(intervalId); // Detener el intervalo actual
      }
      interactionTimeout = setTimeout(() => {
        isUserInteracting = false;
        if (!isUserInteracting) {
          // Reiniciar el intervalo con la velocidad correcta
          intervalId = setInterval(moveCarousel, 13);
        }
      }, 100); // espera 1.5s desde la última interacción antes de reactivar auto-scroll
    }

    function handleMouseEnter() {
      isMouseOverSlider = true;
    }

    function handleMouseLeave() {
      isMouseOverSlider = false;
    }

    function handleTrackMouseLeave() {
      hideTooltip();
      if (isMouseDown) {
        handleMouseUp();
      }
    }

    const CAROUSEL_EDGE_MASK =
      "linear-gradient(to right, transparent 0%, white 40%, white 60%, transparent 100%)";

    /** Alinea la máscara del tooltip con la de .carousel-section (mismo fade lateral). */
    function syncTooltipEdgeMask() {
      if (!tooltip) return;

      const section = document.querySelector(".carousel-section");
      if (!section) return;

      const sectionRect = section.getBoundingClientRect();
      const tooltipRect = tooltip.getBoundingClientRect();
      const maskX = sectionRect.left - tooltipRect.left;

      tooltip.style.webkitMaskImage = CAROUSEL_EDGE_MASK;
      tooltip.style.maskImage = CAROUSEL_EDGE_MASK;
      tooltip.style.webkitMaskSize = `${sectionRect.width}px 100%`;
      tooltip.style.maskSize = `${sectionRect.width}px 100%`;
      tooltip.style.webkitMaskPosition = `${maskX}px 0`;
      tooltip.style.maskPosition = `${maskX}px 0`;
      tooltip.style.webkitMaskRepeat = "no-repeat";
      tooltip.style.maskRepeat = "no-repeat";
    }

    function clearTooltipEdgeMask() {
      if (!tooltip) return;
      tooltip.style.removeProperty("-webkit-mask-image");
      tooltip.style.removeProperty("mask-image");
      tooltip.style.removeProperty("-webkit-mask-size");
      tooltip.style.removeProperty("mask-size");
      tooltip.style.removeProperty("-webkit-mask-position");
      tooltip.style.removeProperty("mask-position");
      tooltip.style.removeProperty("-webkit-mask-repeat");
      tooltip.style.removeProperty("mask-repeat");
    }

    function cancelShowTooltipFrame() {
      if (showTooltipFrame) {
        cancelAnimationFrame(showTooltipFrame);
        showTooltipFrame = 0;
      }
    }

    function isCarouselIcon(node: EventTarget | null): node is HTMLImageElement {
      return (
        node instanceof HTMLImageElement &&
        !!track &&
        track.contains(node)
      );
    }

    function hideTooltip() {
      if (!tooltip) return;
      cancelShowTooltipFrame();
      activeTooltipImg = null;
      tooltip.classList.add("tooltip-hidden");
      tooltip.setAttribute("aria-hidden", "true");
      // No limpiar la máscara aquí: evita 1 frame a opacidad plena al salir
    }

    function updateTooltipLayout() {
      if (!tooltip || !activeTooltipImg) return;

      const iconRect = activeTooltipImg.getBoundingClientRect();
      const centerX = iconRect.left + iconRect.width / 2;

      tooltip.style.position = "fixed";
      tooltip.style.left = `${centerX}px`;
      tooltip.style.top = `${iconRect.top - 8}px`;
      tooltip.style.transform = "translate(-50%, -100%)";
      syncTooltipEdgeMask();
    }

    function refreshTooltip() {
      if (
        !tooltip ||
        !activeTooltipImg ||
        tooltip.classList.contains("tooltip-hidden")
      ) {
        return;
      }
      updateTooltipLayout();
    }

    function showTooltip(img: HTMLImageElement) {
      if (!tooltip || !tooltipLabel) return;

      cancelShowTooltipFrame();
      activeTooltipImg = img;
      tooltipLabel.textContent = img.alt;

      // Posición y máscara mientras sigue oculto (sin flash a opacidad plena)
      updateTooltipLayout();
      void tooltip.offsetWidth;

      showTooltipFrame = requestAnimationFrame(() => {
        showTooltipFrame = requestAnimationFrame(() => {
          showTooltipFrame = 0;
          if (!tooltip || activeTooltipImg !== img) return;
          updateTooltipLayout();
          void tooltip.offsetWidth;
          tooltip.classList.remove("tooltip-hidden");
          tooltip.setAttribute("aria-hidden", "false");
        });
      });
    }

    function handleMouseOver(e: MouseEvent) {
      const target = e.target;
      if (isCarouselIcon(target)) {
        showTooltip(target);
      }
    }

  </script>
</astro>
