---
interface Props {
  alt: string;
  src: string;
}

var {alt, src} = Astro.props;
---

<astro>
  <div
    class="carousel-item sm:mx-2.5 md:mx-5 lg:mx-8 xl:mx-10 sm:w-[3.75rem] md:w-[4.5rem] lg:w-[6rem] xl:w-[6.75rem]"
    data-icon-glow
  >
    <img
      alt={alt}
      fetchpriority="high"
      width="150"
      height="75"
      decoding="async"
      data-nimg="1"
      class="carousel-item__img relative z-[1] ease-in-out duration-200 transform hover:scale-110 2xl:hover:scale-125"
      style="color:transparent;"
      draggable="false"
      src={src}
    />
  </div>

  <style>
    .carousel-item {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 4.25rem;
      margin-right: 14px;
      opacity: 1;
      overflow: visible;
    }

    .carousel-item__img {
      display: block;
      height: 100%;
      width: auto;
      max-width: 100%;
      object-fit: contain;
      object-position: center center;
    }

    @media (min-width: 640px) {
      .carousel-item {
        height: 4.875rem;
      }
    }

    @media (min-width: 1024px) {
      .carousel-item {
        height: 5.625rem;
      }
    }
  </style>
</astro>
