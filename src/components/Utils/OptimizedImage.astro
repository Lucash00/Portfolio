---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCardLogoWebpSrc } from "../../utils/cardLogoUrls";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "sync" | "auto";
  id?: string;
  draggable?: boolean | "true" | "false";
  style?: string;
}

const {
  src,
  alt,
  class: className,
  width,
  height,
  loading = "lazy",
  fetchpriority,
  decoding = "async",
  id,
  draggable,
  style,
} = Astro.props;

const resolvedSrc =
  typeof src === "string" ? getCardLogoWebpSrc(src, "card") : src;
---

{
  typeof resolvedSrc === "string" ? (
    <img
      src={resolvedSrc}
      alt={alt}
      class={className}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      id={id}
      draggable={draggable}
      style={style}
    />
  ) : (
    <Image
      src={resolvedSrc}
      alt={alt}
      class={className}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      id={id}
      draggable={draggable}
      style={style}
    />
  )
}
