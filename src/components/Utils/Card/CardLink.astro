---
export interface Props {
  link: string;
  compact?: boolean;
}
import { FiExternalLink } from "react-icons/fi";

const { link, compact = false } = Astro.props;

const linkClass = compact
  ? "group flex flex-col relative w-full my-2.5 sm:my-3 md:my-4 rounded-lg ease-in-out duration-300 sm:transform-none transform md:hover:-translate-y-1 md:hover:shadow-lg md:hover:shadow-gray-700"
  : "group flex flex-col relative w-full sm:my-6 sm:mx-2 md:my-8 md:mx-3 lg:my-8 lg:mx-4 xl:my-8 xl:mx-8 2xl:my-8 2xl:mx-16 rounded-lg ease-in-out duration-300 sm:transform-none transform md:hover:-translate-y-1 md:hover:shadow-lg md:hover:shadow-gray-700";

const cardBodyClass =
  "relative w-full grid grid-cols-10 rounded-b-lg overflow-hidden bg-slate-100";
---

<astro>
  <a href={link} class={linkClass}>
    <div class="card-accent-bar" aria-hidden="true"></div>
    <div class={cardBodyClass}>
      <slot />
      <div class="absolute top-2 right-2 text-gray-400 pointer-events-none z-10 sm:text-base lg:text-lg xl:text-xl">
        <FiExternalLink />
      </div>
    </div>
  </a>
</astro>
