---
interface Props {
  title: string;
  logo?: string; // Parámetro opcional para el logo
}

const { title, logo } = Astro.props;
---

<h1 class="text-4xl text-left font-extrabold tracking-tight text-white flex items-center gap-3">
  {logo && (
    <img
      src={logo}
      alt={`${title} logo`}
      class="h-10 w-auto shrink-0 object-contain"
    />
  )}
  <span>{title}</span>
</h1>
