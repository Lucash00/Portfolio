---
import OptimizedImage from "../OptimizedImage.astro";

interface Props {
  title: string;
  logo?: string;
  class?: string;
  description?: string;
}

const { title, logo, class: className = "", description } = Astro.props;
---
<div class:list={[description ? "w-full" : "w-fit max-w-full"]}>
  <h1
    class:list={[
      "w-fit max-w-full text-4xl text-left font-extrabold tracking-tight text-white flex items-center gap-3",
      className,
    ]}
  >
    {
      logo && (
        <OptimizedImage
          src={logo}
          alt={`${title} logo`}
          class="h-10 w-auto shrink-0 object-contain select-none"
          width={40}
          height={40}
        />
      )
    }
    <span data-text-glow class="text-mouse-glow">{title}</span>
  </h1>
  {
    description && (
      <p class="mt-2 w-full max-w-none text-sm md:text-base font-medium tracking-tight text-slate-300 text-pretty">
        {description}
      </p>
    )
  }
</div>
