---
interface Props {
  title: string;
  logo?: string;
  class?: string;
}

const { title, logo, class: className = "" } = Astro.props;
---

<h1
  class:list={[
    "w-fit max-w-full text-4xl text-left font-extrabold tracking-tight text-white flex items-center gap-3",
    className,
  ]}
>
  {
    logo && (
      <img
        src={logo}
        alt={`${title} logo`}
        class="h-10 w-auto shrink-0 object-contain select-none"
      />
    )
  }
  <span data-text-glow class="text-mouse-glow">{title}</span>
</h1>
