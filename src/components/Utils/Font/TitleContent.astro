---
interface Props {
  title: string | never;
  logo?: string;
}

const { title, logo } = Astro.props;
---

<h2 class="font-bold text-2xl mb-2 flex items-center gap-3">
  {
    logo && (
      <img
        src={logo}
        alt={`${title} logo`}
        class="h-10 w-auto shrink-0 object-contain"
      />
    )
  }
  <span>{title}</span>
</h2>
