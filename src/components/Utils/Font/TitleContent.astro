---
import OptimizedImage from "../OptimizedImage.astro";

interface Props {
  title: string | never;
  logo?: string;
}

const { title, logo } = Astro.props;
---



<div class="card-entry-title-wrap relative mb-2">

  <h2 class="relative flex items-center gap-3">

    {

      logo && (

        <OptimizedImage
          src={logo}
          alt={`${title} logo`}
          class="h-10 w-auto shrink-0 object-contain"
          width={40}
          height={40}
        />

      )

    }

    <span class="block min-w-0 flex-1 text-2xl font-bold text-gray-900 animate-cardEntryTitleIn">

      {title}

    </span>

  </h2>

</div>

