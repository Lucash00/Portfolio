---
import CardLink from "../Utils/Card/CardLink.astro";
import OptimizedImage from "../Utils/OptimizedImage.astro";
import { cardEntryTitleClass } from "../Utils/Card/cardEntryTitle";
import TextContent from "../Utils/Font/TextContent";
import type { Experience } from "../../data/experiences";

export interface Props extends Pick<
  Experience,
  | "title"
  | "provider"
  | "briefDescription"
  | "tags"
  | "logo"
  | "startDate"
  | "endDate"
  | "type"
> {
  compact?: boolean;
}

const {
  title,
  provider,
  briefDescription,
  tags,
  logo,
  startDate,
  endDate,
  type,
  compact = false,
} = Astro.props;

const visibleTags = compact ? tags.slice(0, 4) : tags;
const metaClass = compact
  ? "mb-2 text-gray-400 text-sm sm:text-[0.9375rem]"
  : "mb-2 text-gray-400 sm:text-xs md:text-sm";
const tagClass = compact ? "portfolio-tag" : "portfolio-tag portfolio-tag--list";
const subtitle = provider
  ? `${provider} / ${startDate} - ${endDate ?? "Actualidad"}`
  : `${startDate} - ${endDate ?? "Actualidad"}`;
const experienceLink = `/experiencia/${encodeURIComponent(title.replace(/\s+/g, "-"))}`;
---

<CardLink link={experienceLink} compact={compact}>
  {
    logo ? (
      <div class="sm:col-span-10 sm:mt-4 sm:mb-2 md:col-span-3 flex items-center justify-center">
        <div class="card-logo-wrap">
          <OptimizedImage
            src={logo}
            alt={title}
            class="card-logo card-logo-img md:group-hover:animate-logoWobble"
            width={224}
            height={96}
          />
        </div>
      </div>
    ) : (
      <div class="hidden md:block md:col-span-3" />
    )
  }
  <div
    class="sm:px-3 sm:py-2 md:py-3 sm:border-t-2 md:border-l-2 sm:pt-3 sm:border-slate-200 md:px-4 sm:col-span-10 md:col-span-7"
  >
    <div class={cardEntryTitleClass}>{title}</div>
    <p class={metaClass}>
      {subtitle}
      <span class="text-gray-500"> · {type}</span>
    </p>
    <TextContent content={briefDescription} variant="compact" />
    {
      visibleTags.map((tag) => (
        <span class={tagClass}>
          {tag}
        </span>
      ))
    }
  </div>
</CardLink>
