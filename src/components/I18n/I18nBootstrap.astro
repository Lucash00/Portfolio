---
import { catalogs } from "../../i18n/locales";
import { DEFAULT_LOCALE } from "../../i18n/config";
---

<script is:inline define:vars={{ catalogs, defaultLocale: DEFAULT_LOCALE }}>
  (function () {
    const STORAGE_KEY = "portfolio-locale";
    const COOKIE = "portfolio-locale";

    function readCookie() {
      const match = document.cookie.match(
        new RegExp("(?:^|; )" + COOKIE + "=([^;]*)"),
      );
      return match ? decodeURIComponent(match[1]) : null;
    }

    function resolveLocale(raw) {
      if (raw && catalogs[raw]) return raw;
      return defaultLocale;
    }

    function getByPath(source, path) {
      return path.split(".").reduce(function (acc, part) {
        if (acc && typeof acc === "object" && part in acc) return acc[part];
        return undefined;
      }, source);
    }

    function createT(locale) {
      const messages = catalogs[locale] || catalogs[defaultLocale];
      const fallback = catalogs[defaultLocale];
      return function t(key) {
        var value = getByPath(messages, key);
        if (typeof value !== "string") value = getByPath(fallback, key);
        return typeof value === "string" ? value : key;
      };
    }

    function applyDom(locale) {
      var t = createT(locale);
      document.querySelectorAll("[data-i18n]").forEach(function (el) {
        var key = el.getAttribute("data-i18n");
        if (key) el.textContent = t(key);
      });
      document.querySelectorAll("[data-i18n-aria]").forEach(function (el) {
        var key = el.getAttribute("data-i18n-aria");
        if (key) el.setAttribute("aria-label", t(key));
      });
      document.querySelectorAll("[data-i18n-placeholder]").forEach(function (el) {
        var key = el.getAttribute("data-i18n-placeholder");
        if (key) el.placeholder = t(key);
      });
    }

    function refreshDom(locale) {
      window.__PORTFOLIO_I18N__ = {
        locale: locale,
        catalogs: catalogs,
        t: createT(locale),
      };
      document.documentElement.lang = locale;
      applyDom(locale);
      document.documentElement.classList.remove("i18n-pending");
      window.dispatchEvent(
        new CustomEvent("portfolio:locale-change", {
          detail: { locale: locale },
        }),
      );
    }

    function readLocale() {
      return resolveLocale(
        localStorage.getItem(STORAGE_KEY) ||
          readCookie() ||
          document.documentElement.lang,
      );
    }

    function syncDomFromStorage() {
      refreshDom(readLocale());
    }

    function bootI18n() {
      syncDomFromStorage();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bootI18n, { once: true });
    } else {
      bootI18n();
    }

    document.addEventListener("astro:before-swap", function () {
      var locale = readLocale();
      if (locale !== defaultLocale) {
        document.documentElement.classList.add("i18n-pending");
      }
    });

    document.addEventListener("astro:page-load", function () {
      var isHome = Boolean(document.querySelector('[data-page-enter="fade"]'));
      if (
        isHome &&
        !document.documentElement.classList.contains("glow-ready")
      ) {
        document.addEventListener(
          "portfolio:page-enter-complete",
          syncDomFromStorage,
          { once: true },
        );
        return;
      }
      syncDomFromStorage();
    });

    document.addEventListener("portfolio:after-route-swap", function () {
      var isHome = Boolean(document.querySelector('[data-page-enter="fade"]'));
      if (!isHome) {
        syncDomFromStorage();
        return;
      }

      if (document.documentElement.classList.contains("glow-ready")) {
        syncDomFromStorage();
        return;
      }

      document.addEventListener(
        "portfolio:page-enter-complete",
        function () {
          syncDomFromStorage();
        },
        { once: true },
      );
    });
  })();
</script>

<script>
  import {
    beginNavigationScrollRevealHold,
    finishPageEnterGlowPause,
    markPageEnterNavigation,
    markHeroRotatorSpaReset,
    revealPageEnterContent,
  } from "../Utils/ScrollReveal/pageEnter.js";
  import { prepScrollRevealState } from "../Utils/ScrollReveal/scrollRevealPrep.js";

  let pageEnterBootRan = false;

  function runPageEnterBoot() {
    if (pageEnterBootRan) return;
    pageEnterBootRan = true;

    document.documentElement.classList.add(
      "glow-paused",
      "page-enter-boot",
    );
    document.documentElement.classList.remove("glow-ready");

    beginNavigationScrollRevealHold();
    prepScrollRevealState({ skipSettledShortcut: true });
    revealPageEnterContent();
    finishPageEnterGlowPause();
  }

  document.addEventListener("astro:before-swap", () => {
    pageEnterBootRan = false;
    markPageEnterNavigation();
    markHeroRotatorSpaReset();
    beginNavigationScrollRevealHold();
    document.documentElement.classList.add("glow-paused");
    document.documentElement.classList.remove("glow-ready");
  });

  document.addEventListener("astro:page-load", runPageEnterBoot);
</script>
