---
import HomePreviewSection from "./HomePreviewSection.astro";
import ExperiencePreviewList from "../Experience/ExperiencePreviewList.astro";
import ProjectList from "../Project/ProjectList.astro";
import { experiences } from "../../data/experiences";
import { projects } from "../../data/projects";

const PREVIEW_COUNT = 3;
---

<HomePreviewSection
  title="Experiencias"
  viewMoreHref="/experiencia"
  description="Un vistazo rápido a mis experiencias laborales, formación y evolución en el sector."
>
  <ExperiencePreviewList experiences={experiences} limit={PREVIEW_COUNT} />
</HomePreviewSection>

<HomePreviewSection
  title="Proyectos"
  viewMoreHref="/proyectos"
  description="Proyectos destacados con enfoque práctico en desarrollo frontend, backend y despliegue."
>
  <ProjectList projects={projects} limit={PREVIEW_COUNT} compact />
</HomePreviewSection>
