---
import HomeSectionTitle from "./HomeSectionTitle.astro";
import { t } from "../../i18n/astro";

interface Props {
  title: string;
  viewMoreHref: string;
  viewMoreLabel?: string;
  description?: string;
  titleI18nKey?: string;
  descriptionI18nKey?: string;
}

const {
  title,
  viewMoreHref,
  viewMoreLabel = t("home.viewMore"),
  description,
  titleI18nKey,
  descriptionI18nKey,
} = Astro.props;
---

<section
  class="home-preview-section mt-12 sm:mt-16 md:mt-24 lg:mt-28 mb-10 sm:mb-12 md:mb-16"
>
  <div class="mx-6 md:mx-[10%]">
    <HomeSectionTitle
      title={title}
      i18nKey={titleI18nKey}
      class="mb-4 sm:mb-5 md:mb-6"
    />
    {
      description && (
        <p
          data-text-glow
          class="scroll-reveal-item text-mouse-glow mb-4 sm:mb-5 md:mb-6 -mt-1 w-full max-w-none text-sm md:text-base font-medium tracking-tight text-slate-300 text-shadow text-pretty"
          data-i18n={descriptionI18nKey}
        >
          {description}
        </p>
      )
    }
    <slot />
  </div>

  <div class="flex justify-center mt-5 sm:mt-6 md:mt-8 w-full">
    <a
      href={viewMoreHref}
      class="scroll-reveal-item home-preview-link"
      data-i18n="home.viewMore"
    >
      {viewMoreLabel}
      <span class="home-preview-link-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .home-preview-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #9ca3af;
    border: 1px solid rgba(156, 163, 175, 0.45);
    border-radius: 0.5rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    transition:
      color 0.35s ease,
      border-color 0.35s ease,
      background-color 0.35s ease,
      transform 0.35s ease;
  }

  @media (min-width: 640px) {
    .home-preview-link {
      padding: 0.625rem 1.375rem;
      font-size: 0.875rem;
    }
  }

  .home-preview-link-arrow {
    display: inline-block;
    transition: transform 0.35s ease;
  }

  .home-preview-link:hover,
  .home-preview-link:focus-visible {
    color: #fbbf24;
    border-color: rgba(251, 191, 36, 0.55);
    background-color: rgba(251, 191, 36, 0.06);
    transform: translateY(-2px);
  }

  .home-preview-link:hover .home-preview-link-arrow,
  .home-preview-link:focus-visible .home-preview-link-arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .home-preview-link,
    .home-preview-link-arrow {
      transition: color 0.2s ease, border-color 0.2s ease,
        background-color 0.2s ease;
    }

    .home-preview-link:hover,
    .home-preview-link:focus-visible {
      transform: none;
    }

    .home-preview-link:hover .home-preview-link-arrow,
    .home-preview-link:focus-visible .home-preview-link-arrow {
      transform: none;
    }
  }
</style>
