---
interface Props {
  title: string;
  class?: string;
  id?: string;
}

const { title, class: className = "", id } = Astro.props;
---

<h2
  id={id}
  data-text-glow
  class:list={[
    "scroll-reveal-item home-section-title text-mouse-glow w-fit max-w-full text-left text-white font-extrabold tracking-tight text-shadow text-balance",
    "text-lg sm:text-xl md:text-2xl lg:text-[1.75rem]",
    className,
  ]}
>
  {title}
</h2>

<style>
  .text-shadow {
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.75);
  }
</style>
