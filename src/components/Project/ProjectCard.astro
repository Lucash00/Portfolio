---
import CardLink from "../Utils/Card/CardLink.astro";
import TextContent from "../Utils/Font/TextContent";
export interface Props {
  title: string;
  briefDescription: string;
  description: string;
  tags: string[];
  projectUrl?: string;
  logo: string;
  media?: string[];
  startDate: string;
  endDate: string;
  company?: string;
  compact?: boolean;
}

const {
  title,
  briefDescription,
  tags,
  logo,
  startDate,
  endDate,
  company,
  compact = false,
} = Astro.props;

const visibleTags = compact ? tags.slice(0, 4) : tags;
const logoColClass = compact
  ? "sm:col-span-10 sm:mt-4 sm:mb-2 md:col-span-3 flex items-center justify-center"
  : "sm:col-span-10 sm:mt-10 sm:mb-5 md:col-span-3 lg:col-span-2 xl:col-span-2 2xl:col-span-2 flex items-center justify-center";
const logoImgClass = compact
  ? "object-contain sm:max-h-16 md:max-h-20 md:max-w-[45%] h-auto"
  : "object-cover sm:max-w-[35%] md:max-w-[50%] lg:max-w-[40%] xl:max-w-[40%] 2xl:max-w-[35%] h-auto";
const bodyColClass = compact
  ? "sm:px-3 sm:py-2 md:py-3 sm:border-t-2 md:border-l-2 sm:pt-3 sm:border-slate-200 md:px-4 sm:col-span-10 md:col-span-7"
  : "sm:px-3 sm:py-2 md:py-4 sm:border-t-2 md:border-l-2 sm:pt-4 sm:border-slate-200 md:px-6 sm:col-span-10 md:col-span-7 lg:col-span-8 xl:col-span-8 2xl:col-span-8";
const titleClass = compact
  ? "font-bold text-sm sm:text-base md:text-lg mb-1 leading-snug"
  : "font-bold sm:text-2xl md:text-3xl mb-2";
---

<astro>
  <CardLink
    link={`/proyecto/${encodeURIComponent(title.replace(/\s+/g, "-"))}`}
    compact={compact}
  >
    <div class={logoColClass}>
      <img src={logo} alt={title} class={logoImgClass} />
    </div>
    <div class={bodyColClass}>
      <div class={titleClass}>{title}</div>
      <p class="text-gray-400 sm:text-xs md:text-sm mb-2">
        {company ? company : "Autodidacta"} / {startDate} - {endDate}
      </p>
      <TextContent content={briefDescription} />
      {
        visibleTags.map((tag) => (
          <span class="inline-block bg-gray-300 rounded-full sm:px-2 sm:py-1 md:px-3 md:py-1 sm:mr-1 sm:my-1 md:mr-2 md:my-2 sm:text-xs md:text-sm font-semibold text-gray-700 ">
            {tag}
          </span>
        ))
      }
    </div>
  </CardLink>
</astro>
