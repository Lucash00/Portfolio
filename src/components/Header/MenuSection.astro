---
import OptimizedImage from "../Utils/OptimizedImage.astro";

interface Props {
  href: string;
  icon: string | ImageMetadata;
  text: string;
  /** Clave en `src/i18n/locales/es.ts` para cambio de idioma en cliente */
  i18nKey?: string;
}
var { href, icon, text, i18nKey } = Astro.props;
const currentPath = Astro.url.pathname;

const relatedPaths: Record<string, string> = {
  "/proyectos": "/proyecto",
  "/certificados": "/certificado",
  "/experiencia": "/experiencia",
  "/sobreMi": "/sobreMi",
  "/blog": "/post"
};

const isActive =
  currentPath === href ||
  (href in relatedPaths && currentPath.startsWith(relatedPaths[href]));
---

<astro>
  <div class="flex h-full flex-1 z-40 opacity-100">
    <a
      href={href}
      data-menu-link
      data-active={isActive ? "true" : undefined}
      data-astro-prefetch="hover"
      class:list={[
        "menu-link group flex h-full w-full flex-col border-b-2 box-border pt-2 pb-0 text-center transition-colors duration-150 ease-in-out",
        "md:px-3 lg:px-5 xl:px-7 2xl:px-8",
        isActive
          ? "text-white border-transparent hover:cursor-pointer hover:text-yellow-400 hover:border-yellow-400"
          : "text-gray-400 border-transparent hover:cursor-pointer hover:text-yellow-400 hover:border-yellow-400",
      ]}
    >
      <span
        class:list={[
          "menu-link__content block flex-1 pb-1 transition-transform duration-150 ease-in-out",
          "group-hover:scale-110",
        ]}
      >
        {typeof icon === "string" ? (
          <i class={icon + " block text-xl leading-none mb-0.5"}></i>
        ) : (
          <OptimizedImage
            src={icon}
            alt=""
            width={icon.width}
            height={icon.height}
            class="block h-5 w-5 mb-0.5 object-contain"
          />
        )}
        <span
          class="block md:text-xxs lg:text-xs 2xl:text-sm leading-tight"
          data-i18n={i18nKey}
        >
          {text}
        </span>
      </span>
    </a>
  </div>
</astro>