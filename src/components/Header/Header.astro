---
import ProfileAvatarImage from "../Utils/ProfileAvatarImage.astro";
import HeaderNavLocalized from "./HeaderNavLocalized.jsx";
import Translator from "../Translator/Translator.jsx";
import { t } from "../../i18n/astro";

const isAboutActive = /\/sobreMi\/?$/i.test(Astro.url.pathname);
---

<header
  id="header"
  transition:persist="site-header"
  class="header fixed left-0 right-0 z-40 w-full"
>
  <div
    class="header__inner relative flex min-h-10 md:grid md:w-[80%] md:grid-cols-[auto_1fr] md:items-stretch md:gap-x-4 md:ml-auto md:mr-[10%] md:py-0 md:pl-2 md:pr-1 lg:mx-[10%] lg:gap-x-6"
  >
    <a
      id="header-avatar-link"
      href="/sobreMi"
      data-astro-prefetch="hover"
      aria-label={t("nav.aboutAria")}
      data-i18n-aria="nav.aboutAria"
      aria-current={isAboutActive ? "page" : undefined}
      class:list={[
        "header__avatar-link relative hidden h-full w-auto shrink-0 self-stretch overflow-hidden rounded-full md:mx-3 md:block lg:ml-6",
        isAboutActive && "is-active",
      ]}
    >
      <div
        id="header-avatar-wrap"
        class="header__avatar-wrap relative h-full w-full overflow-hidden rounded-full"
      >
        <ProfileAvatarImage
          id="header-avatar-img"
          class="absolute inset-0 h-full w-full"
          width={256}
          height={256}
        />
      </div>
    </a>

    <HeaderNavLocalized client:only="react" />
  </div>

  <div class="header__lang">
    <Translator client:only="react" />
  </div>

  <div
    class="header__scroll-progress pointer-events-none absolute inset-x-0 z-50 hidden md:block"
    aria-hidden="true"
  >
    <div class="header__scroll-progress-fill h-full"></div>
  </div>
</header>

<style is:global>
  @import url("https://pro.fontawesome.com/releases/v5.10.0/css/all.css");
</style>

<style>
  /* Esquina del <header> (barra translúcida a ancho completo), no del nav interno */
  .header {
    --header-corner-inset: 0.5rem;
  }

  .header__lang {
    position: absolute;
    top: 50%;
    right: var(--header-corner-inset);
    z-index: 55;
    display: flex;
    align-items: center;
    transform: translateY(-50%);
    pointer-events: auto;
  }

  @media (min-width: 768px) {
    /* Misma fila que el nav: altura 100 %, ancho = altura → círculo sin JS */
    .header__avatar-link {
      aspect-ratio: 1 / 1;
      height: 100%;
      width: auto;
      min-height: 2.5rem;
      flex-shrink: 0;
    }

    .header__avatar-wrap {
      height: 100%;
      width: 100%;
    }

    /* Astro Image envuelve en <picture>; el hover va sobre el <img> */
    .header__avatar-wrap :global(img) {
      transition: transform 0.28s ease;
      transform: scale(1);
      transform-origin: center center;
    }

    .header__avatar-link:hover .header__avatar-wrap :global(img) {
      transform: scale(1.1);
    }

    .header__avatar-link.is-flying,
    .header__avatar-link:has(.header__avatar-wrap.is-flying),
    .header__avatar-link.is-about-hidden,
    .header__avatar-link:has(.header__avatar-wrap.is-about-hidden) {
      opacity: 0;
      transition: none;
    }

    /* Mantiene el hueco del grid para que el menú no se mueva */
    .header__avatar-link.is-about-hidden,
    .header__avatar-link:has(.header__avatar-wrap.is-about-hidden) {
      visibility: hidden;
      pointer-events: none;
      width: var(--avatar-slot-width, auto);
      min-width: var(--avatar-slot-width, 2.5rem);
    }
  }

  .header__scroll-progress {
    top: calc(100% + 1px);
    height: 3px;
    background: transparent;
  }

  .header__scroll-progress-fill {
    width: 0%;
    background: #22d3ee;
    transition: width 0.12s ease-out;
    will-change: width;
  }

  /* Borde de lectura: fundido transparente → azul en el avance */
  .header__scroll-progress-fill:not(.is-complete) {
    background: linear-gradient(90deg, transparent 0%, #22d3ee 72%);
  }

  .header__scroll-progress-fill.is-complete {
    background: #22d3ee;
  }

  .header {
    top: 0;
    overflow: visible;
    border: 1px solid transparent;
    background-color: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: blur(0);
    backdrop-filter: blur(0);
    transition:
      top 0.4s ease,
      border-color 0.35s ease,
      border-radius 0.4s ease,
      background-color 0.35s ease,
      box-shadow 0.35s ease,
      -webkit-backdrop-filter 0.35s ease,
      backdrop-filter 0.35s ease;
  }

  @media (min-width: 768px) {
    .header {
      top: 2.5rem;
    }

    .header.scrolled {
      top: 0;
    }
  }

  /* Barra a ancho completo; tinte cyan-900 (como el azul claro del gradiente superior) */
  .header.scrolled {
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(22, 78, 99, 0.6);
    box-shadow:
      0 4px 14px -2px rgba(0, 0, 0, 0.28),
      0 10px 28px -6px rgba(8, 47, 73, 0.45);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .header.scrolled {
      background-color: rgba(22, 78, 99, 0.45);
    }
  }

  @keyframes headerReloadFadeIn {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  .header.header--reload-fade-in {
    animation: headerReloadFadeIn 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    html.header-reload-boot #header {
      opacity: 1;
    }

    .header.header--reload-fade-in {
      animation: none;
    }
  }
</style>

<script>
  const STICK_DISTANCE = 72;
  const TOP_OFFSET_PX = 40;

  let spaNavigation = false;

  document.addEventListener("astro:before-swap", () => {
    spaNavigation = true;
  });

  function playHeaderReloadFade() {
    const header = document.getElementById("header");
    if (!header) return;

    document.documentElement.classList.remove("header-reload-boot");
    header.classList.remove("header--reload-fade-in");
    void header.offsetWidth;
    header.classList.add("header--reload-fade-in");

    header.addEventListener(
      "animationend",
      () => header.classList.remove("header--reload-fade-in"),
      { once: true },
    );
  }

  function maybePlayHeaderReloadFade() {
    if (spaNavigation) {
      spaNavigation = false;
      document.documentElement.classList.remove("header-reload-boot");
      return;
    }

    if (document.documentElement.classList.contains("header-reload-boot")) {
      playHeaderReloadFade();
    }
  }

  document.addEventListener("astro:page-load", maybePlayHeaderReloadFade);

  if (document.documentElement.classList.contains("header-reload-boot")) {
    maybePlayHeaderReloadFade();
  }

  const updateScrollProgress = () => {
    const fill = document.querySelector(".header__scroll-progress-fill");
    if (!(fill instanceof HTMLElement)) return;

    const maxScroll =
      document.documentElement.scrollHeight - window.innerHeight;
    const ratio = maxScroll > 0 ? Math.min(window.scrollY / maxScroll, 1) : 0;
    fill.style.width = `${ratio * 100}%`;
    fill.classList.toggle("is-complete", ratio >= 0.995);
  };

  const updateHeaderScroll = () => {
    const header = document.getElementById("header");
    if (!header) return;

    const y = window.scrollY;
    const isDesktop = window.matchMedia("(min-width: 768px)").matches;

    if (!isDesktop) {
      header.style.removeProperty("top");
      header.classList.toggle("scrolled", y > 50);
      updateScrollProgress();
      return;
    }

    if (y <= 0) {
      header.style.removeProperty("top");
      header.classList.remove("scrolled");
      updateScrollProgress();
      return;
    }

    const stickProgress = Math.min(y / STICK_DISTANCE, 1);
    header.style.top = `${TOP_OFFSET_PX * (1 - stickProgress)}px`;
    header.classList.toggle("scrolled", stickProgress >= 0.65);
    updateScrollProgress();
  };

  const onHeaderUpdate = () => {
    updateHeaderScroll();
    updateScrollProgress();
  };

  onHeaderUpdate();
  window.addEventListener("scroll", onHeaderUpdate, { passive: true });
  window.addEventListener("resize", onHeaderUpdate, { passive: true });
  document.addEventListener("astro:page-load", onHeaderUpdate);

  document.addEventListener("astro:page-load", () => {
    const link = document.getElementById("header-avatar-link");
    const wrap = document.getElementById("header-avatar-wrap");
    if (!link) return;
    if (!/\/sobreMi\/?$/i.test(window.location.pathname)) {
      link.classList.remove("is-flying", "is-about-hidden");
      link.style.removeProperty("--avatar-slot-width");
      wrap?.classList.remove("is-flying", "is-about-hidden");
    }
  });

  if (!(window as unknown as { __menuSameRouteGuard__?: boolean }).__menuSameRouteGuard__) {
    (window as unknown as { __menuSameRouteGuard__?: boolean }).__menuSameRouteGuard__ = true;

    document.addEventListener(
      "click",
      (event) => {
        const link = (event.target as Element | null)?.closest(
          "a[data-menu-link][data-active='true']",
        );
        if (!link) return;
        event.preventDefault();
        event.stopImmediatePropagation();
      },
      true,
    );
  }
</script>