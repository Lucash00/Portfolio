---
import ContactButtons from "../Utils/Link/ContactButtons.jsx";
import AboutMeAvatarFly from "./AboutMeAvatarFly.jsx";
import AboutMeProfileAvatar from "./AboutMeProfileAvatar.jsx";

const profileAvatarSrc = "https://avatars.githubusercontent.com/u/168908236?v=4";
---

<AboutMeAvatarFly client:load />

<section class="flex flex-col lg:flex-row items-center justify-between px-6 py-12">
  <div class="w-full lg:w-1/3 flex flex-col items-center lg:justify-start mb-8 lg:mb-0">
    <div class="about-profile-with-hint">
      <AboutMeProfileAvatar client:load githubSrc={profileAvatarSrc} />
      <div class="about-click-hint" aria-hidden="true">
        <div class="about-click-hint__label">
          <p class="about-click-hint__text">Click me!</p>
          <svg
            class="about-click-hint__arrow"
            viewBox="0 0 72 68"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M 28 6 C 16 22, 18 42, 62 58"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M 56 52 L 64 58 L 58 64"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </div>
    </div>
    <div class="mt-4">
      <ContactButtons client:load />
    </div>
  </div>

  <div class="w-full lg:w-2/3">
    <div
      class="sm:p-4 md:p-6 rounded-lg border-t-2 border-l-2 border-r-2 border-transparent bg-gradient-to-b to-transparent from-gray-700"
    >
      <h1
        class="sm:text-2xl md:text-4xl lg:text-4xl xl:text-5xl 2xl:text-5xl sm:mb-4 md:mb-8 font-bold text-slate-200"
      >
        Hola, soy <span class="text-amber-400">Lucas Moreno</span>
      </h1>
      <p
        class="sm:text-base md:text-md lg:text-lg xl:text-lg 2xl:text-lg text-gray-300 leading-relaxed text-justify"
      >
        Soy desarrollador web apasionado por la creación de experiencias digitales
        únicas, funcionales y centradas en el usuario. Mi enfoque combina habilidades
        de <strong>FrontEnd</strong> y <strong>BackEnd</strong>, lo que me permite
        abordar proyectos de manera integral, desde la concepción de interfaces <strong
          >atractivas</strong
        > y <strong>responsive</strong>, hasta la implementación de sistemas <strong
          >robustos</strong
        > y <strong>escalables</strong>.
        <br /><br />
        Mi compromiso con la excelencia técnica se refleja en cada detalle: <strong
          >diseño intuitivo</strong
        >, <strong>análisis de datos</strong>, <strong>optimización de rendimiento</strong
        > y una <strong>comunicación fluida</strong> que garantiza que cada proyecto
        alcance su máximo potencial. La adaptabilidad y la curiosidad son las claves
        que me permiten seguir creciendo y explorar nuevas formas de transformar ideas
        en soluciones tecnológicas reales.
        <br /><br />
        Cuando no estoy programando, disfruto aprendiendo sobre tendencias emergentes,
        perfeccionando mi conocimiento de la programación y explorando cómo la tecnología
        puede impactar positivamente.
      </p>
    </div>
  </div>
</section>

<style>
  .about-profile-with-hint {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }

  /* Capa decorativa: no ocupa espacio en el flujo del layout */
  .about-click-hint {
    display: none;
    position: absolute;
    right: 100%;
    top: 50%;
    transform: translateY(-42%);
    margin-right: 0.15rem;
    z-index: 1;
    color: #fff;
    pointer-events: none;
    user-select: none;
  }

  @media (min-width: 768px) {
    .about-click-hint {
      display: block;
    }
  }

  .about-click-hint__label {
    position: relative;
    display: inline-block;
    padding-bottom: 2.75rem;
    padding-right: 0.25rem;
  }

  .about-click-hint__text {
    font-family: "Caveat", "Segoe Print", "Comic Sans MS", cursive;
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    display: inline-block;
    transform: rotate(-10deg) translateX(-0.85rem);
    margin: 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    opacity: 0.92;
  }

  /* Origen del trazo: debajo del centro vertical del texto */
  .about-click-hint__arrow {
    position: absolute;
    left: 33%;
    top: 52%;
    width: clamp(4.25rem, 6.5vw, 5.5rem);
    height: auto;
    opacity: 0.9;
    transform: rotate(8deg);
    transform-origin: 28% 0%;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.25));
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-click-hint__text {
      animation: about-hint-wiggle 2.8s ease-in-out infinite;
    }

    .about-click-hint__arrow {
      animation: about-hint-arrow-wiggle 2.8s ease-in-out infinite 0.15s;
    }
  }

  @keyframes about-hint-wiggle {
    0%,
    100% {
      transform: rotate(-10deg) translateX(-0.85rem) translateY(0);
    }
    50% {
      transform: rotate(-8deg) translateX(-0.85rem) translateY(-2px);
    }
  }

  @keyframes about-hint-arrow-wiggle {
    0%,
    100% {
      transform: rotate(8deg) translate(0, 0);
    }
    50% {
      transform: rotate(10deg) translate(2px, 1px);
    }
  }
</style>
