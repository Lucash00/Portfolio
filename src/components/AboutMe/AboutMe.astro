---
import { getImage } from "astro:assets";
import ContactButtons from "../Utils/Link/ContactButtons.jsx";
import AboutMeAvatarFly from "./AboutMeAvatarFly.jsx";
import AboutMeProfileAvatar from "./AboutMeProfileAvatar.jsx";
import animeProfile from "../../assets/animeprofile.png";
import AboutMeIntro from "./AboutMeIntro.jsx";
import { t } from "../../i18n/astro";

const profileAvatarSrc = "https://avatars.githubusercontent.com/u/168908236?v=4";
const animeSrc = (
  await getImage({ src: animeProfile, width: 384, height: 384, format: "webp" })
).src;
const githubAvatarSrc = (
  await getImage({ src: profileAvatarSrc, width: 384, height: 384, format: "webp" })
).src;
---

<section class="flex flex-col lg:flex-row items-center justify-between px-6 py-12">
  <div class="w-full lg:w-1/3 flex flex-col items-center lg:justify-start mb-8 lg:mb-0">
    <div
      class="about-profile-with-hint about-avatar-stage"
      data-scroll-reveal-zone="exclude"
    >
      <AboutMeProfileAvatar
        client:load
        githubSrc={githubAvatarSrc}
        animeSrc={animeSrc}
      />
      <AboutMeAvatarFly client:load />
      <div class="about-click-hint md:animate-slideIn" aria-hidden="true">
        <div class="about-click-hint__label">
          <p class="about-click-hint__text" data-i18n="about.clickHint">
            {t("about.clickHint")}
          </p>
          <svg
            class="about-click-hint__arrow"
            viewBox="0 0 72 68"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M 28 6 C 16 22, 18 42, 62 58"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M 56 52 L 64 58 L 58 64"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </div>
    </div>
    <div class="mt-4 md:animate-slideIn">
      <ContactButtons client:load />
    </div>
  </div>

  <div class="w-full lg:w-2/3 md:animate-slideIn">
    <article class="about-intro">
      <div class="about-intro__panel">
        <div class="about-intro__border" aria-hidden="true"></div>

        <div class="about-intro__content">
        <AboutMeIntro client:only="react" />
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  /* Avatar + borde: sin slideIn (animación propia de vuelo / borde) */
  .about-avatar-stage {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }

  .about-profile-with-hint {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }

  /* Capa decorativa: no ocupa espacio en el flujo del layout */
  .about-click-hint {
    display: none;
    position: absolute;
    right: 100%;
    top: 50%;
    transform: translateY(-42%);
    margin-right: 0.15rem;
    z-index: 1;
    color: #fff;
    pointer-events: none;
    user-select: none;
  }

  @media (min-width: 768px) {
    .about-click-hint {
      display: block;
    }
  }

  .about-click-hint__label {
    position: relative;
    display: inline-block;
    padding-bottom: 2.75rem;
    padding-right: 0.25rem;
  }

  .about-click-hint__text {
    font-family: "Caveat", "Segoe Print", "Comic Sans MS", cursive;
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    display: inline-block;
    transform: rotate(-10deg) translateX(-0.85rem);
    margin: 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    opacity: 0.92;
  }

  /* Origen del trazo: debajo del centro vertical del texto */
  .about-click-hint__arrow {
    position: absolute;
    left: 33%;
    top: 52%;
    width: clamp(4.25rem, 6.5vw, 5.5rem);
    height: auto;
    opacity: 0.9;
    transform: rotate(8deg);
    transform-origin: 28% 0%;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.25));
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-click-hint__text {
      animation: about-hint-wiggle 2.8s ease-in-out infinite;
    }

    .about-click-hint__arrow {
      animation: about-hint-arrow-wiggle 2.8s ease-in-out infinite 0.15s;
    }
  }

  @keyframes about-hint-wiggle {
    0%,
    100% {
      transform: rotate(-10deg) translateX(-0.85rem) translateY(0);
    }
    50% {
      transform: rotate(-8deg) translateX(-0.85rem) translateY(-2px);
    }
  }

  @keyframes about-hint-arrow-wiggle {
    0%,
    100% {
      transform: rotate(8deg) translate(0, 0);
    }
    50% {
      transform: rotate(10deg) translate(2px, 1px);
    }
  }

  /* Bloque de presentación (misma columna y cuerpo de texto que antes) */
  .about-intro {
    width: 100%;
  }

  .about-intro__panel {
    position: relative;
    overflow: visible;
    border-radius: 1rem;
  }

  /* Mismo gradiente y animación de abajo→arriba que el borde de la foto */
  .about-intro__border {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: 2px;
    background: linear-gradient(90deg, transparent 0%, #22d3ee 72%);
    clip-path: inset(0 0 0 100% round 1rem);
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    animation: about-intro-border-sweep 1.15s cubic-bezier(0.33, 1, 0.68, 1) 0.28s
      forwards;
  }

  /* Derecha → izquierda (evita el salto brusco arriba del barrido vertical) */
  @keyframes about-intro-border-sweep {
    from {
      clip-path: inset(0 0 0 100% round 1rem);
    }

    to {
      clip-path: inset(0 0 0 0 round 1rem);
    }
  }

  .about-intro__content {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border-radius: calc(1rem - 2px);
    padding: 1rem;
    user-select: none;
    -webkit-user-select: none;
    pointer-events: none;
    background: linear-gradient(
      145deg,
      rgba(8, 47, 73, 0.42) 0%,
      rgba(15, 23, 42, 0.28) 48%,
      rgba(15, 23, 42, 0.12) 100%
    );
    -webkit-backdrop-filter: blur(12px) saturate(1.15);
    backdrop-filter: blur(12px) saturate(1.15);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.04) inset,
      0 18px 42px -22px rgba(8, 47, 73, 0.85);
  }

  @media (min-width: 768px) {
    .about-intro__content {
      padding: 1.5rem;
    }
  }

  :global(.about-intro__title) {
    position: relative;
    margin: 0 0 1rem;
    padding-left: 0;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #f8fafc;
    font-size: clamp(1.85rem, 3.8vw, 3.35rem);
  }

  @media (min-width: 768px) {
    :global(.about-intro__title) {
      margin-bottom: 2rem;
      font-size: clamp(2.35rem, 4.2vw, 3.75rem);
    }
  }

  :global(.about-intro__name) {
    display: block;
    margin-top: 0.12em;
    color: #fbbf24;
    text-shadow: 0 0 28px rgba(251, 191, 36, 0.28);
  }

  @media (min-width: 640px) {
    :global(.about-intro__name) {
      display: inline;
      margin-top: 0;
      margin-left: 0.2em;
    }
  }

  /* :global — el cuerpo lo renderiza AboutMeBody (React); el scope de Astro no llega ahí */
  :global(.about-intro__body) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  :global(.about-intro__body p) {
    margin: 0;
    text-align: justify;
    line-height: 1.65;
    color: #cbd5e1;
    font-size: 1rem;
  }

  @media (min-width: 768px) {
    :global(.about-intro__body p) {
      font-size: 1.0625rem;
    }
  }

  @media (min-width: 1024px) {
    :global(.about-intro__body p) {
      font-size: 1.125rem;
    }
  }

  @media (min-width: 1280px) {
    :global(.about-intro__body p) {
      font-size: 1.125rem;
    }
  }

  @media (min-width: 1536px) {
    :global(.about-intro__body p) {
      font-size: 1.125rem;
    }
  }

  :global(.about-intro__body strong) {
    font-weight: 600;
    color: #e2e8f0;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-intro__border {
      animation: none;
      clip-path: inset(0 0 0 0 round 1rem);
    }
  }
</style>
