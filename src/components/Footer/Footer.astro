---
import { t } from "../../i18n/astro";

const currentYear = new Date().getFullYear();
---

<footer
  class="site-footer w-full border-t border-slate-600/50 pt-6 pb-8 sm:pt-6 sm:pb-8 md:pt-8 md:pb-10"
  data-i18n-aria="footer.aria"
  aria-label={t("footer.aria")}
>
  <div class="mx-6 md:mx-[10%]">
  <div
    class="flex flex-col gap-4 md:gap-6"
  >
    <div class="min-w-0">
      <p class="text-sm sm:text-xs md:text-sm font-semibold tracking-tight text-slate-200">
        Lucas Moreno Corral
      </p>
      <p class="mt-0.5 sm:mt-1 text-xs text-slate-400" data-i18n="footer.role">
        {t("footer.role")}
      </p>
    </div>

    <nav
      class="flex flex-wrap gap-x-3 gap-y-1.5 sm:gap-x-3 sm:gap-y-1 md:gap-x-5 md:gap-y-2 text-xs font-medium uppercase tracking-wide text-slate-400"
      data-i18n-aria="footer.navAria"
      aria-label={t("footer.navAria")}
    >
      <a
        href="/"
        class="transition-colors hover:text-amber-400 focus-visible:text-amber-400"
        data-i18n="nav.home"
      >
        {t("nav.home")}
      </a>
      <a
        href="/proyectos"
        class="transition-colors hover:text-amber-400 focus-visible:text-amber-400"
        data-i18n="nav.projects"
      >
        {t("nav.projects")}
      </a>
      <a
        href="/certificados"
        class="transition-colors hover:text-amber-400 focus-visible:text-amber-400"
        data-i18n="nav.certificates"
      >
        {t("nav.certificates")}
      </a>
      <a
        href="/sobreMi"
        class="transition-colors hover:text-amber-400 focus-visible:text-amber-400"
        data-i18n="nav.about"
      >
        {t("nav.about")}
      </a>
      <a
        href="#contacto"
        class="transition-colors hover:text-amber-400 focus-visible:text-amber-400"
        data-i18n="contact.title"
      >
        {t("contact.title")}
      </a>
    </nav>
  </div>

  <p class="mt-4 sm:mt-4 md:mt-6 text-center text-xs text-slate-500 sm:text-left">
    © {currentYear} Lucas Moreno Corral. <span data-i18n="footer.rights">{t("footer.rights")}</span>
  </p>
  </div>
</footer>
