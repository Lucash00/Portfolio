---
import TechCarousel from "../Utils/Carousel/TechCarousel.astro";
import ContactButtons from "../Utils/Link/ContactButtons.jsx";
import HeroTitleRotator from "../Utils/HeroTitleRotator.jsx";
import HeroIntro from "./HeroIntro.jsx";
import HomeSectionTitleLocalized from "../Home/HomeSectionTitleLocalized.jsx";
import HomeScrollCue from "../Home/HomeScrollCue.jsx";
---

<astro>
  <section
    class="hero-section text-shadow sm:pt-5 md:mt-10 lg:mt-20 sm:mb-24 tall-narrow:mb-36 md:mb-32 lg:mb-16 2xl:mb-24 mx-6 md:mx-[10%]"
  >
    <div class="py-8 w-full lg:py-8">
      <h1
        data-text-glow
        class="text-mouse-glow w-fit max-w-full mb-6 lg:mb-10 text-left font-extrabold tracking-tight text-white sm:text-2xl sm:leading-snug md:text-4xl lg:text-6xl"
        data-no-scroll-reveal
      >
        <HeroTitleRotator interval={4000} client:only="react" />
      </h1>
      
      <HeroIntro client:only="react" />
      <div class="scroll-reveal-item z-0 mt-16 sm:mt-12 md:max-w-screen-md lg:max-w-screen-lg">
        <ContactButtons client:load />
      </div>
    </div>    
  </section>
  
  <div class="mx-6 md:mx-[10%]">
    <HomeSectionTitleLocalized
      client:only="react"
      i18nKey="hero.technologiesTitle"
      className="mb-3 sm:mb-4 sm:mt-20 tall-narrow:mt-32 md:mt-28 lg:mt-24 xl:mt-12 md:!mb-5"
    />
  </div>

  <TechCarousel />

  <div class="home-scroll-cue-wrap">
    <HomeScrollCue client:only="react" />
  </div>
</astro>

<style>
  .text-shadow {
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
  }

  .hero-section h1[data-text-glow] {
    perspective: 700px;
  }
</style>

<style is:global>
  #home-experiences {
    scroll-margin-top: calc(var(--header-height, 4.5rem) + 2.5rem);
  }

  .home-scroll-cue-wrap {
    width: 100%;
    height: 0;
    margin: 0;
    padding: 0;
    pointer-events: none;
  }

  .home-scroll-cue {
    position: fixed;
    left: 50%;
    bottom: max(1.25rem, env(safe-area-inset-bottom, 0px));
    z-index: 35;
    display: flex;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-50%) translateY(0.75rem);
    transition:
      opacity 0.35s ease,
      visibility 0.35s ease,
      transform 0.35s ease;
  }

  .home-scroll-cue--visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .home-scroll-cue__btn:disabled {
    cursor: default;
    pointer-events: none;
  }

  .home-scroll-cue__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: #9ca3af;
    background: transparent;
    border: 1px solid rgba(156, 163, 175, 0.45);
    border-radius: 9999px;
    cursor: pointer;
    box-shadow: none;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    transition:
      color 0.35s ease,
      border-color 0.35s ease,
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  @media (min-width: 640px) {
    .home-scroll-cue__btn {
      width: 3rem;
      height: 3rem;
    }
  }

  .home-scroll-cue__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    line-height: 1;
    transition: transform 0.35s ease;
  }

  @media (min-width: 640px) {
    .home-scroll-cue__icon {
      font-size: 1.05rem;
    }
  }

  .home-scroll-cue__btn:hover,
  .home-scroll-cue__btn:focus-visible {
    color: #22d3ee;
    border-color: rgba(34, 211, 238, 0.55);
    background: transparent;
    transform: translateY(-3px);
    box-shadow: 0 0 18px rgba(34, 211, 238, 0.18);
  }

  .home-scroll-cue__btn:hover .home-scroll-cue__icon,
  .home-scroll-cue__btn:focus-visible .home-scroll-cue__icon {
    transform: translateY(3px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-scroll-cue--visible .home-scroll-cue__icon {
      animation: home-scroll-cue-bob 2.4s ease-in-out infinite;
    }
  }

  @keyframes home-scroll-cue-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-scroll-cue,
    .home-scroll-cue__btn,
    .home-scroll-cue__icon {
      transition:
        color 0.2s ease,
        border-color 0.2s ease,
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    .home-scroll-cue--visible .home-scroll-cue__icon {
      animation: none;
    }

    .home-scroll-cue__btn:hover,
    .home-scroll-cue__btn:focus-visible {
      transform: none;
    }

    .home-scroll-cue__btn:hover .home-scroll-cue__icon,
    .home-scroll-cue__btn:focus-visible .home-scroll-cue__icon {
      transform: none;
    }
  }
</style>
