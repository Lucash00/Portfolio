---
import TechCarousel from "../Utils/Carousel/TechCarousel.astro";
import ContactButtons from "../Utils/Link/ContactButtons.jsx";
import TextRotator from "../Utils/TextRotator.jsx";
import HomeSectionTitle from "../Home/HomeSectionTitle.astro";
---

<astro>
  <section
    class="hero-section text-shadow sm:-mt-10 md:mt-10 lg:mt-20 sm:mb-24 md:mb-32 lg:mb-16 2xl:mb-24 mx-6 md:mx-[10%]"
  >
    <div class="py-8 w-full lg:py-8">
      <h1 class="mb-6 lg:mb-10 text-left font-extrabold tracking-tight text-white sm:text-3xl md:text-4xl lg:text-6xl">
        <span class="text-amber-400">Desarrollador</span>
        <span class="md:inline-block">
          <TextRotator
            texts={["Fullstack", "Backend", "Frontend"]}
            interval={4000}
            client:load
          />
        </span>
      </h1>
      
      <p
        class="z-0 mb-2 ml-[1%] sm:text-sm md:text-base lg:text-lg xl:text-xl text-right font-normal text-gray-400 sm:ml-0 sm:text-right"
      >
        Hey! Soy <span class="text-amber-400">Lucas Moreno</span>, un
        Desarrollador Web <span class="text-gray-200">versátil</span> con una sólida
        base en diversas <span class="text-gray-200">tecnologías</span>
      </p>
      <p
        class="z-0 mb-8 text-right font-normal sm:text-sm md:text-base lg:text-lg xl:text-xl text-gray-400 sm:text-right"
      >
        <span class="text-amber-400">Cádiz</span>, España
      </p>
      <div class="z-0 mt-16 sm:mt-12 md:max-w-screen-md lg:max-w-screen-lg">
        <ContactButtons client:load />
      </div>

      <!-- Ajustar el ancho del TechCarousel -->
      
    </div>    
  </section>
  
  <div class="mx-6 md:mx-[10%]">
    <HomeSectionTitle
      title="Tecnologías"
      class="mb-3 sm:mb-4 sm:mt-20 md:mt-28 lg:mt-24 xl:mt-12 md:!mb-5"
    />
  </div>

<!-- Tecnologías -->
<TechCarousel/>
  


</astro>

<style>
  /* .ladosTransparentes {
    mask-image: linear-gradient(to right, transparent, white, transparent);
  } */
  .text-shadow {
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7); /* Sombra al texto */
  }
</style>
