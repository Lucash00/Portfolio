---
import Layout from "../layouts/Layout.astro";
import Title from "../components/Utils/Font/Title.astro";
import CertificateList from "../components/Certificate/CertificateList.astro";
import { certificates } from '../data/certificates';
---

<Layout title="Certificados">

  <main>
    <Title
      title="Certificados"
      logo="/Certificates/logo.png"
      description="Certificaciones y formación complementaria que respaldan mi perfil técnico."
    />
    <CertificateList certificates={certificates} />
  </main>

</Layout>
