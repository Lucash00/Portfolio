---
import Layout from "../layouts/Layout.astro";
import Title from "../components/Utils/Font/Title.astro";
import CertificateListLocalized from "../components/Certificate/CertificateListLocalized.jsx";
import { t } from "../i18n/astro";
---

<Layout title={t("pages.certificates.title")}>
  <main>
    <Title
      title={t("pages.certificates.title")}
      titleI18nKey="pages.certificates.title"
      logo="/Certificates/logo.png"
      description={t("pages.certificates.description")}
      descriptionI18nKey="pages.certificates.description"
    />
    <CertificateListLocalized client:load />
  </main>
</Layout>
