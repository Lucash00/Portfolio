---
import Layout from "../layouts/Layout.astro";
import Title from "../components/Utils/Font/Title.astro";
import ProjectListLocalized from "../components/Project/ProjectListLocalized.jsx";
import { t } from "../i18n/astro";
---

<Layout title={t("pages.projects.title")}>
  <main>
    <Title
      title={t("pages.projects.title")}
      titleI18nKey="pages.projects.title"
      description={t("pages.projects.description")}
      descriptionI18nKey="pages.projects.description"
    />
    <ProjectListLocalized client:load />
  </main>
</Layout>
