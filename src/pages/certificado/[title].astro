---
import Layout from "../../layouts/Layout.astro";
import CertificateDetailLocalized from "../../components/Certificate/CertificateDetailLocalized.jsx";
import {
  getAllCertificateSlugs,
  getCertificateBySlug,
} from "../../data/getLocalized";
import { DEFAULT_LOCALE } from "../../i18n/config";

export async function getStaticPaths() {
  return getAllCertificateSlugs().map((slug) => ({
    params: { title: slug },
  }));
}

const slug = Astro.params.title;
if (!slug) {
  throw new Error("No slug parameter provided");
}

const certificate = getCertificateBySlug(slug, DEFAULT_LOCALE);
if (!certificate) {
  throw new Error(`Certificate with slug '${slug}' not found`);
}
---

<Layout title={`Certificado: ${certificate.title}`}>
  <CertificateDetailLocalized client:load slug={slug} />
</Layout>
