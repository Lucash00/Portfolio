---
import Layout from "../../layouts/Layout.astro";
import ProjectDetailLocalized from "../../components/Project/ProjectDetailLocalized.jsx";
import { getAllProjectSlugs, getProjectBySlug } from "../../data/getLocalized";
import { DEFAULT_LOCALE } from "../../i18n/config";

export async function getStaticPaths() {
  return getAllProjectSlugs().map((slug) => ({
    params: { title: slug },
  }));
}

const slug = Astro.params.title;
if (!slug) {
  throw new Error("No slug parameter provided");
}

const project = getProjectBySlug(slug, DEFAULT_LOCALE);
if (!project) {
  throw new Error(`Project with slug '${slug}' not found`);
}
---

<Layout title={`Proyecto: ${project.title}`}>
  <ProjectDetailLocalized client:load slug={slug} />
</Layout>
