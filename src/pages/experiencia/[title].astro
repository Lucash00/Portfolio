---
import Layout from "../../layouts/Layout.astro";
import ExperienceDetailLocalized from "../../components/Experience/ExperienceDetailLocalized.jsx";
import {
  getAllExperienceSlugs,
  getExperienceBySlug,
} from "../../data/getLocalized";
import { DEFAULT_LOCALE } from "../../i18n/config";

export async function getStaticPaths() {
  return getAllExperienceSlugs().map((slug) => ({
    params: { title: slug },
  }));
}

const slug = Astro.params.title;
if (!slug) {
  throw new Error("No slug parameter provided");
}

const experience = getExperienceBySlug(slug, DEFAULT_LOCALE);
if (!experience) {
  throw new Error(`Experience with slug '${slug}' not found`);
}
---

<Layout title={`Experiencia: ${experience.title}`}>
  <ExperienceDetailLocalized client:load slug={slug} />
</Layout>
