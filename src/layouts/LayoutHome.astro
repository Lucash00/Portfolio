---
interface Props {
  title: string;
}
import Header from "../components/Header/Header.astro";
import SideMenu from "../components/SideMenu/SideMenu.astro";
import GhostCodeBackground from "../components/Background/GhostCodeBackground.jsx";
import TextMouseGlowManager from "../components/Utils/Font/TextMouseGlowManager.jsx";
import ScrollReset from "../components/Utils/ScrollReset.astro";
import PageEnd from "../components/PageEnd/PageEnd.astro";
import ScrollRevealManager from "../components/Utils/ScrollReveal/ScrollRevealManager.jsx";
import I18nBootstrap from "../components/I18n/I18nBootstrap.astro";
import I18nEarlyScript from "../components/I18n/I18nEarlyScript.astro";
import { ClientRouter } from "astro:transitions";
import { DEFAULT_LOCALE } from "../i18n/config";
import "../styles/scrollReveal.css";
---

<!doctype html>
<html lang={DEFAULT_LOCALE} class="scrollbar-hide">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Portfolio de Lucas Moreno Corral, desarrollador de software Fullstack & DevOps con experiencia en tecnologías modernas como React, TailwindCSS, Astro, Spring, y muchas más. Proyectos destacados y habilidades en frontend, backend e infraestructura." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Lucas Moreno Corral" />
    
    <!-- Open Graph (para redes sociales) -->
    <meta property="og:title" content="Portfolio de Lucas Moreno Corral" />
    <meta property="og:description" content="Portfolio de Lucas Moreno Corral, desarrollador de software Fullstack & DevOps con experiencia en tecnologías modernas como React, TailwindCSS, Astro, Spring, y muchas más. Proyectos destacados y habilidades en frontend, backend e infraestructura." />
    <meta property="og:image" content="/Portada/Portada.png" />
    <meta property="og:url" content="https://www.lucas-moreno-dev.com/" />
    <meta property="og:type" content="website" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="/Portada/Portada.png" />
    <meta name="twitter:title" content="Portfolio de Lucas Moreno Corral" />
    <meta name="twitter:description" content="Portfolio de Lucas Moreno Corral, desarrollador de software Fullstack & DevOps con experiencia en tecnologías modernas como React, TailwindCSS, Astro, Spring, y muchas más. Proyectos destacados y habilidades en frontend, backend e infraestructura." />
    <meta name="twitter:image" content="/Portada/Portada.png" />

    <!-- Favicon -->
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.lucas-moreno-dev.com/" />

    <!-- Meta Generador -->
    <meta name="generator" content="Astro" />
    
    <!-- Título de la página -->
    <title>Portfolio Lucas Moreno</title>

    <!-- Fuente Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;800&display=swap" rel="stylesheet" />
    <ScrollReset />
    <I18nEarlyScript />
    <ClientRouter />
  </head>

  <body class="bg-gradient-to-t from-slate-950 via-blue-950 to-cyan-900 bg-fixed tracking-tighter leading-none">
    <I18nBootstrap />
    <GhostCodeBackground client:idle transition:persist="ghost-code" />
    <TextMouseGlowManager client:idle />
    <ScrollRevealManager client:idle />
    <Header />
    <div
      class="relative z-10 justify-between pt-36 pb-0 md:animate-fadeIn"
      data-page-enter="fade"
      transition:animate="none"
    >
      <!-- SideMenu para móviles -->
      <SideMenu />
      <slot />
      <PageEnd />
    </div>
  </body>
</html>

<style>
  body {
    font-family: "Poppins", sans-serif;
    word-spacing: 0.01rem;
  }
</style>
